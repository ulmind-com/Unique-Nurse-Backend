# ==========================================================
# Unique Nurse and Aya Services - Environment Configuration
# ==========================================================

# ---- Application ----
APP_NAME="Unique Nurse and Aya Services"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ---- Security / JWT ----
# IMPORTANT: replace SECRET_KEY in production with a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_python_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- Database (MongoDB Atlas) ----
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=unique_nurse_aya

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ---- Email (Resend API) ----
# Sign up at https://resend.com and get an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Unique Nurse and Aya Services <onboarding@resend.dev>"
EMAIL_FROM_NAME="Unique Nurse and Aya Services"
ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com

# ---- CORS ----
# Comma-separated list of allowed origins. Use * to allow all (not recommended in prod).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8080

# ---- Rate limiting (SlowAPI) ----
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute

# ---- Frontend (used for password reset links etc.) ----
FRONTEND_URL=http://localhost:3000

# ---- First / bootstrap admin (auto-created on startup if not present) ----
FIRST_ADMIN_NAME="Super Admin"
FIRST_ADMIN_EMAIL=admin@uniquenurseaya.com
FIRST_ADMIN_PASSWORD=set_a_strong_password
